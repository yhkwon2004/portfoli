{
  "name": "portfoli",
  "version": "1.0.0",
  "private": true,
  "description": "HOURGLASS \u2014 a cinematic single-screen portfolio driven by a real sand simulation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-css.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:css && npm run build && npm run audit",
    "test": "npm run build && playwright test",
    "test:only": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "audit": "node scripts/audit-content.mjs",
    "images": "node scripts/images.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
