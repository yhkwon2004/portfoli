  "gradient": {
    "pearl": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#ffffff",
          "position": 0
        },
        {
          "color": "#e4defe",
          "position": 0.3
        },
        {
          "color": "#c6efff",
          "position": 0.62
        },
        {
          "color": "#ffffff",
          "position": 1
        }
      ]
    },
    "model": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#b3a7ff",
          "position": 0
        },
        {
          "color": "#9ee9ff",
          "position": 1
        }
      ]
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Pretendard"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono",
        "Pretendard"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Instrument Serif"
      ]
    }
  },
  "radius": {
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "nav-h": {
      "$type": "dimension",
      "$value": "76px"
    },
    "maxw": {
      "$type": "dimension",
      "$value": "1480px"
    }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": [
        0.22,
        1,
        0.36,
        1
      ]
    },
    "in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.76,
        0,
        0.24,
        1
      ]
    },
    "spring": {
      "$type": "cubicBezier",
      "$value": [
        0.25,
        1.15,
        0.4,
        1
      ]
    }
  }
